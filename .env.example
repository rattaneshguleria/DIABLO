# Diablo Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=Diablo
APP_VERSION=0.4.0
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Chat
STREAM_RESPONSES=true
MAX_HISTORY_MESSAGES=20

# Memory (Phase 2)
MEMORY_ENABLED=true
SQLITE_DB_PATH=diablo.db
CHROMA_PERSIST_DIR=chroma
EMBEDDING_MODEL=nomic-embed-text
SEMANTIC_MEMORY_ENABLED=true
MEMORY_RETRIEVAL_TOP_K=5
AUTO_EXTRACT_MEMORIES=true

# Tools (Phase 3)
TOOLS_ENABLED=true
MAX_TOOL_STEPS=5
REQUIRE_CONFIRMATION_FOR_COMMANDS=true
ALLOWED_COMMAND_PREFIXES=python,pip,git,dir,ls,echo,cd,type,pytest
WEB_SEARCH_ENABLED=true
MAX_FILE_READ_BYTES=100000
COMMAND_TIMEOUT=30

# Desktop control (Phase 4)
DESKTOP_CONTROL_ENABLED=true
REQUIRE_CONFIRMATION_FOR_DESKTOP_INPUT=true
SCREENSHOT_DIR=screenshots
